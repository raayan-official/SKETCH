<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Sketch</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <script src="javascripts/script.js"></script>
  </head>
  <body class="font-sans">

    <!-- Navbar -->
    <nav class="w-full bg-white z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h3 class="text-2xl font-semibold" style="color: #aa8f6c;">Sketch</h3>
      </div>
    </nav>

    <!-- Main Login Section -->
    <div class="flex justify-center items-center min-h-screen px-4">
      <div class="bg-white rounded-lg shadow-lg p-10 w-full max-w-md">
        <h3 class="text-4xl font-bold mb-4 text-gray-500" style="color: #806441;">
          Admin Access
        </h3>

        <form autocomplete="off" action="/users/login" method="post" class="space-y-4">
          <input
            class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
            type="email"
            style="border-color: #806441;"
            placeholder="Email"
            name="email"
          />
          <input
            class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
            style="border-color: #806441;"
            type="password"
            placeholder="Password"
            name="password"
          />
          <button
            type="submit"
            class="w-full px-6 text-white rounded-full py-3 font-semibold"
            style="background-color: #806441;"
          >
            Login
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
