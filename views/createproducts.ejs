<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <script src="javascripts/script.js"></script>
</head>
<body class="font-sans text-gray-700 ">

  <!-- Navbar -->
  <nav class="bg-white">
    <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
      <h1 class="text-2xl font-semibold" style="color: #aa8f6c;">Sketch <spans style="color: #806441;">Admin</spans></h1>
      <p style="color: #806441;">Welcome, <span class="font-bold" style="color: #806441;">Admin</span>!</p>
    </div>
  </nav>

  <!-- Success Notification -->
  <% if (successMessage && successMessage.length > 0) { %>
    <div class="flash-message fixed top-5 left-1/2 transform -translate-x-1/2 bg-green-500 text-white px-4 py-2 rounded shadow-md">
      <%= successMessage[0] %>
    </div>
  <% } %>
  <!-- Sidebar and Main Content -->
  <div class="flex flex-col lg:flex-row min-h-screen">
    <!-- Sidebar -->
    <aside class="bg-white w-full lg:w-1/4 p-6">
      <nav class="flex flex-col gap-4">
        <a href="#" class="font-medium" style="color: #806441;">All Products</a>
        <a href="#" class=" font-medium" style="color: #806441;">Create New Product</a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 bg-white p-8  rounded-lg mx-4 lg:mx-8 mt-6 lg:mt-0">
      <h2 class="text-2xl font-bold mb-6" style="color: #806441;">Create New Product</h2>
      <form action="/products/create" method="post" enctype="multipart/form-data" autocomplete="off">
        
        <!-- Product Image -->
        <div class="mb-6">
          <label class="block text-lg font-medium  mb-2" style="color: #806441;" >Product Image</label>
          <input type="file" name="image" class="w-full border rounded-lg p-2 outline-none" style="border-color: #806441;">
        </div>

        <!-- Product Details -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-gray-500 mb-4" style="color: #806441;">Product Details</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" name="name" placeholder="Product Name" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
            <input type="text" name="price" placeholder="Product Price" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
            <input type="text" name="discount" placeholder="Discount Price" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
          </div>
        </div>

        <!-- Panel Details -->
        <div class="mb-6">
          <h3 class="text-lg font-semibold text-gray-500 mb-4" style="color: #806441;">Panel Details</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <input type="text" name="bgcolor" placeholder="Background Color" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
            <input type="text" name="panelcolor" placeholder="Panel Color" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
            <input type="text" name="textcolor" placeholder="Text Color" class="w-full border p-3 rounded-lg outline-none" style="border-color: #806441;">
          </div>
        </div>

        <!-- Submit Button -->
        <div class="text-right">
          <button type="submit" class=" text-white px-6 py-3 rounded-lg font-semibold" style="background-color: #806441;">
            Create Product
          </button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>
