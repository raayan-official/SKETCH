<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Sketch</title>
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <script src="javascripts/script.js"></script>
  </head>
  <body class="font-sans">

    <!-- Navbar -->
    <nav class="w-full bg-white z-50">
      <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
        <h3 class="text-2xl font-semibold" style="color: #aa8f6c;">Sketch</h3>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="w-full h-screen flex items-center justify-center px-5 mt-5">
      <div class="flex flex-col md:flex-row gap-10 items-center justify-center">

        <!-- Flash Message Section -->
        <% if (error && error.length > 0) { %>
        <div
          class="flash-message fixed top-5 left-1/2 transform -translate-x-1/2 bg-red-500 text-white px-4 py-2 rounded shadow-md"
        >
          <%= error[0] %>
        </div>
        <% } %>

        <% if (success && success.length > 0) { %>
        <div
          class="flash-message fixed top-5 left-1/2 transform -translate-x-1/2 bg-green-500 text-white px-4 py-2 rounded shadow-md"
        >
          <%= success[0] %>
        </div>
        <% } %>

        <!-- Registration Section -->
        <div class="p-10 bg-white rounded-lg shadow-lg w-full max-w-md">
          <h3
            class="text-4xl font-bold mb-2 text-gray-500"
            style="color: #806441;"
          >
            Welcome to <span style="color: #aa8f6c;">Sketch</span>
          </h3>
          <p class="text-lg mb-6" style="color: #aa8f6c;">
            Create your account to get started
          </p>
          <form
            autocomplete="off"
            action="/users/register"
            method="post"
            class="space-y-4"
          >
            <input
              class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
              type="text"
              style="border-color: #806441;"
              placeholder="Full Name"
              name="fullname"
            />
            <input
              class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
              type="email"
              style="border-color: #806441;"
              placeholder="Email"
              name="email"
            />
            <input
              class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
              style="border-color: #806441;"
              type="password"
              placeholder="Password"
              name="password"
            />
            <button
              class="w-full px-3 text-white transition rounded-full py-3 font-semibold"
              style="background-color: #806441;"
            >
              Create Account
            </button>
          </form>
        </div>

        <!-- Login Section -->
        <div class="p-10 bg-white rounded-lg shadow-lg w-full max-w-md">
          <h3
            class="text-4xl font-bold mb-2 text-gray-500"
            style="color: #806441;"
          >
            Already have an account?
          </h3>
          <p class="text-lg mb-6" style="color: #aa8f6c;">
            Login to continue your journey
          </p>
          <form
            autocomplete="off"
            action="/users/login"
            method="post"
            class="space-y-4"
          >
            <input
              class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
              type="email"
              style="border-color: #806441;"
              placeholder="Email"
              name="email"
            />
            <input
              class="w-full bg-white border rounded-md px-4 py-2 text-gray-700 placeholder-gray-500 outline-none"
              style="border-color: #806441;"
              type="password"
              placeholder="Password"
              name="password"
            />
            <button
              type="submit"
              class="w-full px-6 text-white rounded-full py-3 font-semibold"
              style="background-color: #806441;"
            >
              Login
            </button>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
